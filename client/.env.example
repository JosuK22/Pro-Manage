# ---------------------------------------------------------------------------
# Pro-Manage — client environment
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets here — everything in this file ships to the client.
# ---------------------------------------------------------------------------

# Base URL of the Pro-Manage API (no trailing slash).
# Local development: http://localhost:3003
# Production:        https://your-api.onrender.com
VITE_API_URL=http://localhost:3003
