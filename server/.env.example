# ---------------------------------------------------------------------------
# Pro-Manage — server environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or local mongod).
MONGODB_URI=mongodb://127.0.0.1:27017/pro-manage

# Secret used to sign JWTs. Use a long random string (>= 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=replace-me-with-a-long-random-secret

# JWT lifetime. Accepts the `ms`/jsonwebtoken format: 15m, 2h, 7d ...
JWT_EXPIRES_IN=7d

# `development` | `production` | `test`
NODE_ENV=development

# Port the API listens on.
PORT=3003

# Comma-separated allowlist of browser origins permitted by CORS.
# Example (production): https://pro-manage.vercel.app
CLIENT_URL=http://localhost:5173
